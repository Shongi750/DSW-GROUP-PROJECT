{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "_archive",
    "supabase/functions"
  ],
  "extends": "expo/tsconfig.base"
}