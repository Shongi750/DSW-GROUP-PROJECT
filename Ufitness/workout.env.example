# Get a key at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
# You can also paste the key in Profile → Connect ExerciseDB (no restart needed).
# If you use this file, restart Expo after saving.
EXPO_PUBLIC_RAPIDAPI_KEY=

# Firebase web app config: Firebase console → Project settings → Your apps → Web app.
# Without these the app still runs, but accounts and cloud backup stay switched off.
# Restart Expo after saving.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
