# Copy this file to .env (never commit .env). Restart Expo after saving.
# Backend: Firebase (see HOW-IT-WORKS.md). LoyaltyHub is grocery prices only.

# Get a free key at https://loyaltyhub.co.za/developers
EXPO_PUBLIC_LOYALTYHUB_KEY=

# Firebase console → Project settings → Your apps → Web app
# Paste KEY=value lines (not the JavaScript firebaseConfig snippet).
# Same project for UFitness login, Workout, and Buddies.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# After the project exists, deploy Ufitness/firestore.rules from this folder:
# firebase deploy --only firestore:rules
