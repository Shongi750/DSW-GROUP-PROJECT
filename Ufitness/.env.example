# Copy this file to .env (never commit .env). Restart Expo after saving.
# Accounts: Supabase. Create a project at https://supabase.com, then Project Settings → API.
# Authentication → Sign In / Providers → Email → turn Confirm email on.
# Authentication → Emails → Magic link or OTP body must include {{ .Token }}.
# Run Ufitness/supabase/schema.sql in the SQL editor (UJ gate, buddy/group RLS, DMs, admin, delete).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# LoyaltyHub (live grocery prices) is NOT set here any more: the key is a server
# secret for the loyaltyhub-proxy Edge Function. See DEPLOY-EDGE-FUNCTION.md.

# Optional: ExerciseDB GIFs (https://rapidapi.com). Without it the local exercise list is used.
EXPO_PUBLIC_RAPIDAPI_KEY=
